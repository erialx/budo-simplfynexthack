+MAX_REQUEST_BYTES = 256 * 1024 * 1024
+
+
+def recv_exact(conn, size):
+    """Read one complete protocol field, or return None after early EOF."""
+    chunks = []
+    remaining = size
+    while remaining:
+        chunk = conn.recv(remaining)
+        if not chunk:
+            return None
+        chunks.append(chunk)
+        remaining -= len(chunk)
+    return b"".join(chunks)
+
